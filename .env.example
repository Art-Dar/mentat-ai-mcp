MENTAT_API_URL=http://localhost:8000
# Access token from POST /api/v1/auth/login (leave empty)
MENTAT_API_TOKEN=
# Optional
MENTAT_TIMEOUT_MS=

# HTTP server only (npm run start:http)
# At least 24 characters: letters, digits, - and _
MCP_SECRET=
# Bare tunnel hostname (my-demo.ngrok-free.app)
MCP_ALLOWED_HOSTS=
MCP_PORT=3000